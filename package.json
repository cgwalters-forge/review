{
  "name": "review",
  "private": true,
  "description": "Review queue for cgwalters-bot's Workstream board",
  "type": "module",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "build": "node build.ts",
    "dev": "node build.ts --serve",
    "typecheck": "tsc",
    "test": "node --test 'test/*.test.ts'",
    "check": "npm run typecheck && npm test && npm run build"
  },
  "dependencies": {
    "dompurify": "^3.2.6",
    "markdown-it": "^14.1.0"
  },
  "devDependencies": {
    "@types/markdown-it": "^14.1.2",
    "@types/node": "^24.0.0",
    "esbuild": "^0.25.0",
    "jsdom": "^26.1.0",
    "@types/jsdom": "^21.1.7",
    "typescript": "^5.9.2"
  }
}
